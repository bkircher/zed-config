[
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "\\ c f": ["task::Spawn", { "task_name": "hongdown: format current file" }],
    },
  },
  {
    "context": "EmptyPane || SharedScreen || vim_operator == none && !VimWaiting && vim_mode != insert",
    "bindings": {
      "ctrl-r": "projects::OpenRecent",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-[": "pane::GoBack",
      "ctrl-]": "pane::GoForward",
    },
  },
  {
    "bindings": {
      "cmd-alt-k": "text_finder::Toggle",
      "cmd-alt-l": "workspace::ToggleRightDock",
    },
  },
]
